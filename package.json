{
  "name": "dsh-director",
  "version": "1.0.2",
  "type": "module",
  "description": "DSH导演（dsh-director / dsh导演）· DSH 影视创作插件：精品影视、多集短剧、创意视频、带货商品视频。ZipX 负责剧本→分镜→关键帧→配音→成片，DSH 负责对话、审批与交付。",
  "icon": "./icon.svg",
  "keywords": [
    "dsh导演",
    "dsh-director",
    "DSH导演",
    "导演",
    "AI导演",
    "影视",
    "影视创作",
    "精品影视",
    "多集短剧",
    "微短剧",
    "短剧",
    "短剧生成",
    "竖屏短剧",
    "创意视频",
    "带货视频",
    "商品视频",
    "广告片",
    "品牌视频",
    "小说转视频",
    "剧本转视频",
    "文生视频",
    "AI视频",
    "分镜",
    "关键帧",
    "成片",
    "film",
    "short-drama",
    "commercial-video",
    "storyboard",
    "ai-film",
    "video",
    "deepseek-harness",
    "dsh-plugin",
    "zipx"
  ],
  "license": "MIT",
  "homepage": "https://www.zipx.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Digiforge6688/dsh-director.git"
  },
  "bugs": {
    "url": "https://github.com/Digiforge6688/dsh-director/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./skills/*": "./skills/*"
  },
  "files": [
    "lib/**/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "skills",
    "docs",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "market",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepare": "node scripts/build.mjs",
    "prepack": "node scripts/build.mjs",
    "test": "node scripts/build.mjs && npm run check",
    "check": "node scripts/check-tools.mjs && node --import ./scripts/register-stub.mjs scripts/check-skill.mjs && node --import ./scripts/register-stub.mjs scripts/check-net.mjs && node scripts/check-account-route.mjs && node scripts/check-host.mjs && node scripts/check-panel.mjs && node scripts/sync-locale.mjs --check",
    "locale:sync": "node scripts/sync-locale.mjs",
    "verify:bundle": "node scripts/verify-bundle.mjs",
    "market:check": "node scripts/check-market-ready.mjs",
    "market:index": "node scripts/make-market-index.mjs",
    "test:e2e": "node scripts/e2e-write.mjs",
    "audit": "node scripts/audit.mjs",
    "audit:plan": "node scripts/audit-plan.mjs"
  },
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.0 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-approval",
        "@deepseek-ai/dsh-client-ui-jobs",
        "@deepseek-ai/dsh-client-ui-attachment",
        "@deepseek-ai/dsh-client-ui-deliverables",
        "@deepseek-ai/dsh-client-ui-commands",
        "@deepseek-ai/dsh-client-ui-input-trigger"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-credentials": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-jobs": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-host-webserver": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-session": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-user-approval": "^0.2.0-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-credentials": {
      "optional": true
    },
    "@deepseek-ai/dsh-jobs": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    },
    "@deepseek-ai/dsh-user-approval": {
      "optional": true
    }
  }
}
