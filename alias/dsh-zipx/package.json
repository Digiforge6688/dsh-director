{
  "name": "dsh-zipx",
  "version": "0.6.0",
  "description": "Discovery alias for DSH Director / DSH导演: installs @zipx/dsh-plugin and applies its DSH bundle layer.",
  "keywords": [
    "dsh导演",
    "dsh-director",
    "dsh",
    "dsh-plugin",
    "dsh-zipx",
    "zipx",
    "导演",
    "精品影视",
    "多集短剧",
    "创意视频",
    "带货视频",
    "film",
    "short-drama",
    "storyboard",
    "ai-film",
    "director"
  ],
  "license": "MIT",
  "homepage": "https://www.zipx.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Digiforge6688/zipx-dsh-plugin.git",
    "directory": "alias/dsh-zipx"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "files": [
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@zipx/dsh-plugin": "0.6.0"
  },
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.0 <0.3.0"
  }
}
